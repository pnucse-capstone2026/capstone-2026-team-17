# --- 모든 개발 단계가 공유하는 LLM ---
# OpenRouter 예시입니다. 공급자를 바꾸면 아래 네 값을 함께 바꾸세요.
LLM_PROVIDER=openrouter
API_KEY=<OPENROUTER_API_KEY>
BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-oss-120b
# Optional OpenHands coding model on the same provider; blank keeps MODEL.
OPENHANDS_MODEL=
# Optional semantic-admission model on the same provider; blank keeps MODEL.
ADMISSION_MODEL=
# Optional Testing Arazzo planning model on the same provider; blank keeps MODEL.
ARAZZO_MODEL=
# 다른 지원값:
#   nvidia_nim      + https://integrate.api.nvidia.com/v1 + openai/gpt-oss-20b
#   cloudflare      + 최종 OpenAI 호환 URL + @cf/zai-org/glm-5.3-flash
#   openai_compatible + 해당 endpoint URL + 해당 endpoint의 모델 ID
# Cloudflare URL을 계정 ID로 조립할 때만 아래 값을 채웁니다. 다른 공급자를 선택하면
# 값이 남아 있어도 무시됩니다. Gateway ID만 최종 BASE_URL과 함께 사용할 수도 있습니다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=
TEMPERATURE=0.2
SEED=42
LLM_MAX_COMPLETION_TOKENS=16384
# HTTP가 응답하지 않는 시간과, streaming·내부 재시도까지 포함한 한 LLM turn의
# 총 시간을 각각 제한합니다. Implementation runner에도 같은 값이 전달됩니다.
LLM_TIMEOUT_SECONDS=300
LLM_WALL_TIMEOUT_SECONDS=330
# Cloudflare GPT-OSS structured JSON uses a completed response plus a schema
# instruction; keep ``auto`` unless diagnosing a provider protocol issue.
CLOUDFLARE_STRUCTURED_TRANSPORT=auto
DESIGN_REASONING_EFFORT=medium
DESIGN_SELECTOR_REASONING_EFFORT=low
REQUIREMENTS_REASONING_EFFORT=medium
REQUIREMENTS_MAX_COMPLETION_TOKENS=8192
DESIGN_CLASS_BEHAVIOR_PARALLELISM=8
DESIGN_CLASS_OPERATION_MAX_COMPLETION_TOKENS=16384

# --- LangSmith observability (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=easydep
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# --- 요구사항 분석 실행 방식 ---
ENABLE_BERT_VERIFY=true
ENABLE_FEEDBACK_GATES=false

# --- 시스템 구현 단계 ---
IMPLEMENTATION_AGENT_TEMPERATURE=0.2
IMPLEMENTATION_AGENT_MAX_OUTPUT_TOKENS=16384
IMPLEMENTATION_REASONING_EFFORT=medium
IMPLEMENTATION_REPAIR_REASONING_EFFORT=high
# owner의 기본 도구는 범위 제한 editor/search/check/finish입니다. 기존 terminal 구성은
# 통제된 비교나 되돌리기에만 사용합니다.
IMPLEMENTATION_OWNER_TOOL_MODE=restricted
# 실제 구현 전에 현재 provider/model/OpenHands 도구 왕복을 한 번 검사합니다.
IMPLEMENTATION_OPENHANDS_CANARY=true
IMPLEMENTATION_OPENHANDS_CANARY_REPETITIONS=1
# 429·5xx·timeout과 도구 실행 전 provider 출력 파싱 실패는 같은 LLM 요청만
# 지수 백오프로 최대 세 번 시도합니다. 전체 owner 작업을 처음부터 반복하지 않습니다.
IMPLEMENTATION_OPENHANDS_REQUEST_ATTEMPTS=3
IMPLEMENTATION_OPENHANDS_RETRY_MIN_WAIT_SECONDS=1
IMPLEMENTATION_OPENHANDS_RETRY_MAX_WAIT_SECONDS=8
IMPLEMENTATION_OPENHANDS_RETRY_MULTIPLIER=1.0
# 카나리는 단일 프로토콜 probe만 수행하며, 요청 자체의 transport retry를 재사용합니다.
# 일시적 실패가 다음 요청을 지연시키는 회로 차단 시간은 두지 않습니다.
IMPLEMENTATION_OPENHANDS_CANARY_MAX_ATTEMPTS=1
IMPLEMENTATION_OPENHANDS_CANARY_TRANSIENT_TTL_SECONDS=0
# 서버를 켤 때 별도 Gradle compile까지 미리 실행하려면 true로 바꿉니다.
# 기본 실행은 첫 실제 구현 검사가 필요한 의존성만 받도록 이 작업을 생략합니다.
IMPLEMENTATION_STARTUP_WARMUP=false
# 기본 scaffold의 구현 전 Gradle compile은 생략합니다. 생성기 자체를 점검할 때만 true로 켭니다.
IMPLEMENTATION_VERIFY_INITIAL_COMPILE=false
# OpenHands·Gradle·Node·Trivy·OpenTofu·Playwright가 같은 고정 도구 버전을 사용합니다.
# 통합 실행 스크립트가 필요할 때 docker/Dockerfile.toolchain을 자동으로 빌드합니다.
EASYDEP_TOOLCHAIN_IMAGE=easydep-toolchain:local
EASYDEP_NPM_REGISTRY=https://registry.npmmirror.com

# OpenTofu는 항상 fmt/init/validate를 실행합니다. 실제 CSP 문맥의 dry-run까지 확인하려면
# true로 바꾸고 아래 CSP 인증값과 생성된 variables.tf의 TF_VAR_* 값을 채웁니다.
TESTING_IAC_PLAN=false
# Demo-only Testing bypass. Only the exact value true skips runtime/HTTP/static
# verification; Arazzo plans and normal Testing result artifacts are still generated.
EASYDEP_DEMO_SKIP_VALIDATION=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# ARM_CLIENT_ID=
# ARM_CLIENT_SECRET=
# ARM_TENANT_ID=
# ARM_SUBSCRIPTION_ID=
# GOOGLE_CREDENTIALS=
# TF_VAR_region=ap-northeast-2

# --- MySQL 산출물 저장소 ---
# 개발 스크립트는 컨테이너의 3306을 호스트의 33060으로 공개한다.
# 백엔드를 직접 실행할 때도 아래 값을 그대로 사용한다.
DB_HOST=127.0.0.1
DB_PORT=33060
DB_USER=root
DB_PASSWORD=easydep-local
DB_NAME=easydep
# true이면 서버 시작 시 DB_NAME의 기존 구조와 데이터를 모두 삭제하고 현재 ORM으로 재생성한다.
# 한 번 초기화한 뒤에는 반드시 false로 되돌린다.
DB_SCHEMA_RESET_ON_START=false
