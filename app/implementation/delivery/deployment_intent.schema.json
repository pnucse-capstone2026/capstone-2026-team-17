{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EasyDep deployment intent",
  "type": "object",
  "required": ["schemaVersion", "workloads"],
  "properties": {
    "schemaVersion": {"const": "easydep-deployment-intent/v1alpha1"},
    "namespace": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "createNamespace": {"type": "boolean", "default": true},
    "frontend": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["integrated", "separate"]},
        "publicUrl": {"type": "string", "pattern": "^https?://"},
        "apiBaseUrl": {"type": "string", "pattern": "^https?://"}
      },
      "additionalProperties": false
    },
    "workloads": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "image", "capabilities"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "kind": {"enum": ["Deployment", "StatefulSet", "Job", "CronJob"]},
          "image": {"type": "string", "minLength": 1},
          "artifact": {"enum": ["application", "frontend"]},
          "registryRef": {"type": "string", "minLength": 1},
          "clusterRef": {"type": "string", "minLength": 1},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "schedule": {"type": "string", "minLength": 1},
          "replicas": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {
              "min": {"type": "integer", "minimum": 0},
              "max": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "resources": {
            "type": "object",
            "properties": {
              "requests": {"$ref": "#/$defs/resourceQuantity"},
              "limits": {"$ref": "#/$defs/resourceQuantity"}
            },
            "additionalProperties": false
          },
          "health": {
            "type": "object",
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "readinessPath": {"type": "string", "pattern": "^/"},
              "livenessPath": {"type": "string", "pattern": "^/"}
            },
            "additionalProperties": false
          },
          "service": {
            "type": "object",
            "properties": {
              "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]}
            },
            "additionalProperties": false
          },
          "ingress": {
            "type": "object",
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "tlsSecretName": {"type": "string", "minLength": 1},
              "className": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "autoscaling": {
            "type": "object",
            "properties": {
              "cpuTarget": {"type": "integer", "minimum": 1, "maximum": 100}
            },
            "additionalProperties": false
          },
          "monitoring": {
            "type": "object",
            "properties": {
              "metricsPath": {"type": "string", "pattern": "^/"}
            },
            "additionalProperties": false
          },
          "config": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
            },
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          },
          "externalSecret": {
            "type": "object",
            "required": ["storeName", "remoteKey"],
            "properties": {
              "storeName": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "remoteKey": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "storage": {
            "type": "object",
            "properties": {
              "size": {"type": "string", "minLength": 1},
              "mountPath": {"type": "string", "pattern": "^/"},
              "accessModes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
                }
              }
            },
            "additionalProperties": false
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "service": {"type": "boolean"}, "ingress": {"type": "boolean"},
              "hpa": {"type": "boolean"}, "pdb": {"type": "boolean"},
              "networkPolicy": {"type": "boolean"}, "serviceAccount": {"type": "boolean"},
              "externalSecret": {"type": "boolean"}, "configMap": {"type": "boolean"},
              "pvc": {"type": "boolean"}, "serviceMonitor": {"type": "boolean"}
            }, "additionalProperties": false
          }
        }, "additionalProperties": true
      }
    }
  },
  "$defs": {
    "resourceQuantity": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "string", "minLength": 1},
        "memory": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
